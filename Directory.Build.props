<Project>

  <!-- Спільні налаштування для всіх проєктів рішення -->
  <PropertyGroup>
    <!-- Аналізатори: рекомендований набір правил .NET -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Перевіряти стиль коду (.editorconfig) під час збірки -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Поки що попередження НЕ робимо помилками (спершу розгребти борг) -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- nf003 (healthchecks-version-sync, audit v2.1): єдине джерело істини для версії
         обох пакетів. SignalCli.NET.HealthChecks використовує [InternalsVisibleTo] і
         бінарно прив'язаний до main lib — версії МУСЯТЬ збігатися. Enforced:
         VersionLockstepTests.MainLibAndHealthChecksAdapter_ShareExactSameAssemblyVersion.
         CLAUDE.md "Version-CHANGELOG lockstep" — bump цього property у тому ж коміті
         що й нова `## [X.Y.Z] — YYYY-MM-DD` секція у CHANGELOG.md. -->
    <SignalCliPackageVersion>4.3.0</SignalCliPackageVersion>
  </PropertyGroup>

</Project>
