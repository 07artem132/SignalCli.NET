<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- xunit v3: тестовий проєкт — самостійний виконуваний файл. -->
        <OutputType>Exe</OutputType>
        <!--
          xUnit1051 (xunit v3): порада передавати TestContext.Current.CancellationToken у кожен виклик
          з CancellationToken. Тести вже обмежені власними таймаутами й FakeTimeProvider; це косметика
          скасування, не коректність, а 384 механічні правки не варті шуму в diff.
        -->
        <NoWarn>$(NoWarn);xUnit1051</NoWarn>
        <!-- nf004 (audit v2.1): main lib давно warning-clean із TreatWarningsAsErrors=true;
             тест-проєкт жив без цього й тихо акумулював 3 xUnit1031 warnings у
             SyncDisposeDuringCleanupTests.cs. Тепер опто-в — будь-який новий аналізатор-warning
             у тестах fail'ить build. CLAUDE.md "Audit baseline" фіксує це як invariant. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.1.0"/>
        <!-- D.6: для BuildServiceProvider() у OptionsValidationTests -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14"/>
        <!-- post-modernize-tuning §8b.3 (audit B5): in-memory IConfiguration для тесту нового overload'а.
             `AddInMemoryCollection` поставляється з основним Microsoft.Extensions.Configuration —
             окремого Configuration.Memory пакету на nuget.org немає. -->
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14"/>
        <!-- nf005 (audit v2.1): тримаємо у лінії 10.x (Microsoft.Extensions.* test-helpers
             мають окрему cadence від runtime-пакетів 10.0.x; зараз 10.11.0). MS Learn підтверджує пакет
             (https://learn.microsoft.com/dotnet/core/extensions/timeprovider-testing);
             public-surface (Advance, Start, GetUtcNow, SetLocalTimeZone) — без breaking-changes.
             Реліз містить fixes для .NET 10 BackgroundService.ExecuteAsync threading semantics —
             релевантно для наших Restart*-тестів. -->
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0"/>
        <!-- post-modernize-tuning §5.12 (audit N13): FakeLogger<T> для capture scope-properties. -->
        <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <PackageReference Include="Moq" Version="4.21.0" />
        <!-- xunit.v3.mtp-off: xunit v3 на VSTest-хості, тож фільтри й збір покриття dotnet test у CI без змін. -->
        <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
        <!-- post-modernize-tuning §6.7: JsonTypeInfo<T> усюди в mock-Setup'ах і direct calls. -->
        <Using Include="System.Text.Json.Serialization.Metadata"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\SignalCli\SignalCli.csproj" />
      <!-- post-modernize-tuning §11.C.6: тестуємо HealthChecks-адаптер як справжній consumer -->
      <ProjectReference Include="..\..\src\SignalCli.HealthChecks\SignalCli.HealthChecks.csproj" />
    </ItemGroup>

</Project>
